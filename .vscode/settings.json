{
  // 이 프로젝트 전용 파이썬(.venv)을 기본으로 사용 → fastapi 등 설치한 라이브러리를 VS Code가 찾을 수 있음
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  // 새 터미널을 열면 .venv를 자동으로 켬 (줄 앞에 (.venv) 표시)
  "python.terminal.activateEnvironment": true,
  // backend 폴더를 import 경로에 추가 → "import sheetgen" 같은 줄의 빨간 줄 방지
  "python.analysis.extraPaths": ["./backend"],
  // 타입 검사 수준: basic (strict는 cv2·numpy 때문에 경고가 너무 많음)
  "python.analysis.typeCheckingMode": "basic",
  "python.terminal.executeInFileDir": false,
  // 새 터미널이 backend 폴더에서 열리게 함 (명령 예시가 전부 backend 기준)
  "terminal.integrated.cwd": "${workspaceFolder}/backend"
}
